FROM node:24-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Use dev2 Vite config
ENV VITE_CONFIG_FILE=vite.config.dev2.ts

# Expose port 3000 (will be mapped to 3002 in docker-compose)
EXPOSE 3000

# Start development server with dev2 config
CMD ["npm", "run", "dev:dev2"]

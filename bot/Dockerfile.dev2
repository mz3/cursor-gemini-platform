FROM node:24-alpine

WORKDIR /app

# Install nodemon globally for development
RUN npm install -g nodemon

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Expose port (if needed for debugging)
EXPOSE 3001

# Use nodemon for development with hot reloading
CMD ["npm", "run", "dev:watch"]

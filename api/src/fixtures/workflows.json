[
  {
    "name": "build_application",
    "displayName": "Build Application",
    "description": "Build and deploy an application",
    "config": {
      "queue": "app_builds",
      "steps": ["validate", "build", "test", "deploy"]
    },
    "isActive": true
  },
  {
    "name": "create_schema",
    "displayName": "Create Schema",
    "description": "Create a new data schema with relationships",
    "config": {
      "queue": "schema_creation",
      "steps": ["validate", "create", "generate-code"]
    },
    "isActive": true
  },
  {
    "name": "deploy_application",
    "displayName": "Deploy Application",
    "description": "Deploy application to production environment",
    "config": {
      "queue": "deployment",
      "steps": ["build", "test", "deploy", "health-check"]
    },
    "isActive": true
  },
  {
    "name": "generate_documentation",
    "displayName": "Generate Documentation",
    "description": "Generate API documentation from schemas",
    "config": {
      "queue": "documentation",
      "steps": ["analyze", "generate", "publish"]
    },
    "isActive": true
  },
  {
    "name": "daily_github_report",
    "displayName": "Daily GitHub Issue Report",
    "description": "Creates a daily GitHub issue report every day at 9am EST using the CI/CD GitHub bot",
    "config": {
      "queue": "github_reports",
      "steps": ["schedule", "collect_data", "generate_report", "create_issue"],
      "schedule": {
        "cron": "0 14 * * *",
        "timezone": "America/New_York",
        "description": "Daily at 9:00 AM EST"
      },
      "bot": "cicd-github-manager"
    },
    "isActive": true
  }
]

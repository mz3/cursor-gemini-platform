{
  "watch": ["src"],
  "ext": "ts,js,json",
  "ignore": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__tests__/**",
    "dist/**",
    "node_modules/**"
  ],
  "exec": "npm run build && node dist/index.js",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": "1000",
  "verbose": true
}


